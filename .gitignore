# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/
venv/

# Local secrets — NEVER commit
*.local.json
haismart_keys_backup.json
# private working notes; CLAUDE.private.md carries home-network addresses and device IDs
CLAUDE.md
CLAUDE.private.md

# Editor / OS
.vscode/
.idea/
.DS_Store

# Stray artefacts from local tooling — this repo is swept with `git add -A` at release,
# so anything that lands in the working tree gets committed unless it is named here.
*.wav

# Notification-plugin droppings — a tool writes these into the working tree; they are not the
# project and must never be swept into a commit (release.sh stages every untracked root file).
.peon-*
